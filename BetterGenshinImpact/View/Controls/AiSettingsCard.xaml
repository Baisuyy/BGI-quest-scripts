<UserControl x:Class="BetterGenshinImpact.View.Controls.AiSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <StackPanel>
    <!-- AI 智能决策（内置） -->
    <ui:CardExpander Margin="0,0,0,12" ContentPadding="0">
        <ui:CardExpander.Icon>
            <ui:FontIcon Glyph="&#xf544;" Style="{StaticResource FaFontIconStyle}" />
        </ui:CardExpander.Icon>
        <ui:CardExpander.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:TextBlock FontTypography="Body"
                              Text="AI 智能决策（内置）"
                              TextWrapping="Wrap" />
                <ui:TextBlock Grid.Row="1"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              Text="BGI 自己调用大模型：跑图卡死时接管角色脱困；脚本 ai.Chat() 复用同一份配置与预算"
                              TextWrapping="Wrap" />
            </Grid>
        </ui:CardExpander.Header>
    <StackPanel>
            <Grid Margin="16,16,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="启用内置 AI" />
                <ui:TextBlock Grid.Row="1"
                              Grid.Column="0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"
                              Text="关闭后内核不发出任何请求，全部退回原有规则逻辑" />
                <ui:ToggleSwitch Grid.Row="0"
                                 Grid.RowSpan="2"
                                 Grid.Column="1"
                                 Margin="0,0,36,0"
                                 IsChecked="{Binding Config.AiConfig.Enabled, Mode=TwoWay}" />
            </Grid>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="服务协议" />
                <ui:TextBlock Grid.Row="1"
                              Grid.Column="0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"
                              Text="OpenAI 兼容覆盖 DeepSeek / 通义 / 智谱 / Kimi / Ollama / LM Studio；Anthropic 走原生 Messages API" />
                <ComboBox Grid.Row="0"
                          Grid.RowSpan="2"
                          Grid.Column="1"
                          Width="300"
                          VerticalAlignment="Top"
                          Margin="0,0,36,0"
                          SelectedValue="{Binding Config.AiConfig.Provider, Mode=TwoWay}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Tag="openai" Content="OpenAI 兼容" />
                    <ComboBoxItem Tag="anthropic" Content="Anthropic（Claude）" />
                </ComboBox>
            </Grid>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="服务地址" />
                <ui:TextBlock Grid.Row="2"
                              Grid.Column="0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"
                              Text="OpenAI 兼容填到 /v1；Anthropic 填根地址。非本机回环地址必须是 HTTPS，否则密钥会明文传输" />
                <ui:TextBox Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="1"
                            Width="300"
                            VerticalAlignment="Top"
                            Margin="0,0,36,0"
                            Text="{Binding Config.AiConfig.Endpoint, Mode=TwoWay}"
                            TextWrapping="Wrap" Cursor="IBeam" />
            </Grid>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="模型名" />
                <ui:TextBlock Grid.Row="1"
                              Grid.Column="0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"
                              Text="必须支持工具调用（function calling）才能接管操作，如 deepseek-chat、qwen-max、glm-4-plus" />
                <ui:TextBox Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="300"
                            VerticalAlignment="Top"
                            Margin="0,0,36,0"
                            Text="{Binding Config.AiConfig.ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{Binding Config.AiConfig.ModelName}" />
            </Grid>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="服务密钥" />
                <ui:TextBlock Grid.Row="1"
                              Grid.Column="0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"
                              Text="只随请求头发送，不写入日志，也不会暴露给脚本" />
                <ui:PasswordBox Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Width="300"
                                VerticalAlignment="Top"
                                Margin="0,0,36,0"
                                Password="{Binding Config.AiConfig.ApiKey, Mode=TwoWay}" />
            </Grid>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="跑图卡死接管" />
                <ui:TextBlock Grid.Row="1"
                              Grid.Column="0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"
                              Text="路线连续卡死、即将放弃时，把当前坐标与目标交给模型，由它直接操作角色脱困" />
                <ui:ToggleSwitch Grid.Row="0"
                                 Grid.RowSpan="2"
                                 Grid.Column="1"
                                 Margin="0,0,36,0"
                                 IsChecked="{Binding Config.AiConfig.RescueOnStuck, Mode=TwoWay}" />
            </Grid>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="允许接管时传送" />
                <ui:TextBlock Grid.Row="1"
                              Grid.Column="0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"
                              Text="距离目标超过 80 米时，模型可直接传送过去；关闭后只能用走位脱困" />
                <ui:ToggleSwitch Grid.Row="0"
                                 Grid.RowSpan="2"
                                 Grid.Column="1"
                                 Margin="0,0,36,0"
                                 IsChecked="{Binding Config.AiConfig.AllowTeleport, Mode=TwoWay}" />
            </Grid>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="单次接管步数" />
                <ui:TextBlock Grid.Row="1"
                              Grid.Column="0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"
                              Text="一步一次工具调用；超过后交还规则逻辑，避免在死角里反复烧额度" />
                <ui:NumberBox Grid.Row="0"
                              Grid.RowSpan="2"
                              Grid.Column="1"
                              Width="300"
                              VerticalAlignment="Top"
                              Margin="0,0,36,0"
                              Minimum="1"
                              Maximum="20"
                              SmallChange="1"
                              Value="{Binding Config.AiConfig.RescueMaxSteps, Mode=TwoWay}" />
            </Grid>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="单次接管超时（秒）" />
                <ui:TextBlock Grid.Row="1"
                              Grid.Column="0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"
                              Text="到点立刻停止接管，回到原路线逻辑，不会让一条路线无限挂起" />
                <ui:NumberBox Grid.Row="0"
                              Grid.RowSpan="2"
                              Grid.Column="1"
                              Width="300"
                              VerticalAlignment="Top"
                              Margin="0,0,36,0"
                              Minimum="10"
                              Maximum="300"
                              SmallChange="5"
                              Value="{Binding Config.AiConfig.RescueTimeoutSeconds, Mode=TwoWay}" />
            </Grid>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="附带截图（多模态）" />
                <ui:TextBlock Grid.Row="1"
                              Grid.Column="0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"
                              Text="默认只发坐标与状态，几百 token；开启后每步附一张压缩截图，开销大一个数量级，仅在纯文本判断不准时使用" />
                <ui:ToggleSwitch Grid.Row="0"
                                 Grid.RowSpan="2"
                                 Grid.Column="1"
                                 Margin="0,0,36,0"
                                 IsChecked="{Binding Config.AiConfig.VisionMode, Mode=TwoWay}" />
            </Grid>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="每小时调用上限" />
                <ui:TextBlock Grid.Row="1"
                              Grid.Column="0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"
                              Text="内置决策与脚本共用这一个额度，按滚动一小时统计" />
                <ui:NumberBox Grid.Row="0"
                              Grid.RowSpan="2"
                              Grid.Column="1"
                              Width="300"
                              VerticalAlignment="Top"
                              Margin="0,0,36,0"
                              Minimum="1"
                              Maximum="600"
                              SmallChange="1"
                              Value="{Binding Config.AiConfig.MaxCallsPerHour, Mode=TwoWay}" />
            </Grid>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="单次运行调用上限" />
                <ui:TextBlock Grid.Row="1"
                              Grid.Column="0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"
                              Text="重启 BGI 后清零；连续失败 3 次会自动冷却 2 分钟，防止服务不可用时反复重试" />
                <ui:NumberBox Grid.Row="0"
                              Grid.RowSpan="2"
                              Grid.Column="1"
                              Width="300"
                              VerticalAlignment="Top"
                              Margin="0,0,36,0"
                              Minimum="1"
                              Maximum="2000"
                              SmallChange="10"
                              Value="{Binding Config.AiConfig.MaxCallsPerRun, Mode=TwoWay}" />
            </Grid>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="采样温度" />
                <ui:TextBlock Grid.Row="1"
                              Grid.Column="0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"
                              Text="决策类任务建议 0–0.3；太高会做出无意义动作" />
                <ui:NumberBox Grid.Row="0"
                              Grid.RowSpan="2"
                              Grid.Column="1"
                              Width="300"
                              VerticalAlignment="Top"
                              Margin="0,0,36,0"
                              Minimum="0"
                              Maximum="1"
                              SmallChange="0.1"
                              Value="{Binding Config.AiConfig.Temperature, Mode=TwoWay}" />
            </Grid>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="记录决策日志" />
                <ui:TextBlock Grid.Row="1"
                              Grid.Column="0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"
                              Text="把每次接管所用的工具、耗时与结果写进日志，便于回看模型到底做了什么" />
                <ui:ToggleSwitch Grid.Row="0"
                                 Grid.RowSpan="2"
                                 Grid.Column="1"
                                 Margin="0,0,36,0"
                                 IsChecked="{Binding Config.AiConfig.LogDecisions, Mode=TwoWay}" />
            </Grid>
            <Grid Margin="16,8,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="Body" TextWrapping="Wrap" Text="连通性测试" />
                <ui:TextBlock Grid.Row="1"
                              Grid.Column="0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"
                              Text="{Binding AiTestResult}" />
                <ui:Button Grid.Row="0"
                           Grid.RowSpan="2"
                           Grid.Column="1"
                           Margin="0,0,36,0"
                           VerticalAlignment="Top"
                           Content="发送测试请求"
                           Command="{Binding TestAiConnectionCommand}" />
            </Grid>
    </StackPanel>
</ui:CardExpander>
    </StackPanel>
</UserControl>

<UserControl x:Class="BetterGenshinImpact.View.Controls.SpecialSettingsCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <!-- 特别版设置卡片：日志（落盘级别/诊断包/上传）与远程任务（QQ 机器人 + 米游社绑定）。
         单独成文件是为了在上游同步覆盖 CommonSettingsPage.xaml 后只需重新插一行引用。 -->
    <StackPanel>
        <!-- 日志：查看目录、落盘级别、诊断包、上传。这几项原来塞在「启用遮罩窗口 → 日志遮罩」
             卡片底部，和日志区域背景色、字号混在一起，没人找得到，所以单独拎成一张卡。 -->
        <ui:CardExpander Margin="0,0,0,12"
                         ContentPadding="0"
                         Icon="{ui:SymbolIcon Document24}">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0"
                                  Grid.Column="0"
                                  FontTypography="Body"
                                  Text="日志"
                                  TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1"
                                  Grid.Column="0"
                                  Margin="0,4,0,0"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="查看日志文件、调整落盘详细程度、生成诊断包，或把日志发给开发者排查问题。"
                                  TextWrapping="Wrap" />
                    <ui:Button Grid.Row="0"
                               Grid.RowSpan="2"
                               Grid.Column="1"
                               Margin="0,0,36,0"
                               VerticalAlignment="Center"
                               Command="{Binding GoToLogFolderCommand}"
                               Content="打开日志目录" />
                </Grid>
            </ui:CardExpander.Header>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="218" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Row="0"
                              Grid.Column="0"
                              FontTypography="Body"
                              Text="写入日志文件的详细程度"
                              TextWrapping="Wrap" />
                <ComboBox Grid.Row="0"
                          Grid.Column="1"
                          Margin="0,0,36,0"
                          HorizontalAlignment="Right"
                          MinWidth="150"
                          SelectedIndex="{Binding SelectedLogFileLevel, Mode=TwoWay}">
                    <ComboBoxItem Content="全部（Debug）" />
                    <ComboBoxItem Content="常规（Info）" />
                    <ComboBoxItem Content="仅警告与错误" />
                    <ComboBoxItem Content="仅错误" />
                </ComboBox>
                <ui:TextBlock Grid.Row="1"
                              Grid.Column="0"
                              Margin="0,6,16,0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              Text="只关心有没有报错就选「仅错误」，日志文件会小很多。改完需重启生效。出错时会自动生成诊断包。"
                              TextWrapping="Wrap" />
                <ui:Button Grid.Row="1"
                           Grid.Column="1"
                           Margin="0,6,36,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Command="{Binding BuildDiagnosticsCommand}"
                           Content="生成诊断包" />
                <ui:TextBlock Grid.Row="2"
                              Grid.Column="0"
                              Margin="0,12,16,0"
                              FontTypography="Body"
                              Text="把日志发送给开发者"
                              TextWrapping="Wrap" />
                <ComboBox Grid.Row="2"
                          Grid.Column="1"
                          Margin="0,12,36,0"
                          HorizontalAlignment="Right"
                          MinWidth="150"
                          SelectedIndex="{Binding SelectedLogUploadMode, Mode=TwoWay}">
                    <ComboBoxItem Content="不上传" />
                    <ComboBoxItem Content="仅手动上传" />
                    <ComboBoxItem Content="自动上传" />
                </ComboBox>
                <ui:TextBlock Grid.Row="3"
                              Grid.Column="0"
                              Margin="0,6,16,0"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              Text="上传前会去掉账号、Cookie、令牌、邮箱和本机用户名，只发日志正文。选「自动上传」后，出错和退出时各发一次；不想联网就选「不上传」。"
                              TextWrapping="Wrap" />
                <ui:Button Grid.Row="3"
                           Grid.Column="1"
                           Margin="0,6,36,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Command="{Binding UploadLogCommand}"
                           Content="上传当前日志" />
            </Grid>
        </ui:CardExpander>

        <!-- 远程任务：QQ 机器人下发任务与截图回传；凭证留空时复用通知设置里的 QQ 凭证 -->
        <ui:CardExpander Margin="0,0,0,12"
                         ContentPadding="0"
                         Icon="{ui:SymbolIcon Chat24}">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0"
                                  FontTypography="Body"
                                  Text="远程任务（QQ 机器人）"
                                  TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="在 QQ 里发「一条龙」「截图」即可让 BetterGI 开跑，跑完自动回传截图；启用状态与端口一样重启后生效"
                                  TextWrapping="Wrap" />
                </Grid>
            </ui:CardExpander.Header>
            <StackPanel>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="启用远程任务" />
                    <ui:TextBlock Grid.Row="1"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="只用主实例连接 QQ 开放平台，桌面分身不会重复登录"
                                  TextWrapping="Wrap" />
                    <ui:ToggleSwitch Grid.Row="0"
                                     Grid.RowSpan="2"
                                     Grid.Column="1"
                                     Margin="0,0,24,0"
                                     IsChecked="{Binding Config.RemoteTaskConfig.QqBotEnabled, Mode=TwoWay}" />
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="关闭窗口后继续在后台运行" />
                    <ui:TextBlock Grid.Row="1"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="点关闭只隐藏窗口，机器人保持在线、随时可下发任务；真正退出请用托盘菜单的「退出」"
                                  TextWrapping="Wrap" />
                    <ui:ToggleSwitch Grid.Row="0"
                                     Grid.RowSpan="2"
                                     Grid.Column="1"
                                     Margin="0,0,24,0"
                                     IsChecked="{Binding Config.RemoteTaskConfig.KeepAliveInTray, Mode=TwoWay}" />
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="显示托盘小图标" />
                    <ui:TextBlock Grid.Row="1"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="关闭后台保活时会一并隐藏，避免程序在后台却没有入口"
                                  TextWrapping="Wrap" />
                    <ui:ToggleSwitch Grid.Row="0"
                                     Grid.RowSpan="2"
                                     Grid.Column="1"
                                     Margin="0,0,24,0"
                                     IsChecked="{Binding Config.RemoteTaskConfig.ShowTrayIcon, Mode=TwoWay}" />
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="接受群聊指令" />
                    <ui:TextBlock Grid.Row="1"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="关闭后只接受私聊；群聊里需要 @机器人 才会响应"
                                  TextWrapping="Wrap" />
                    <ui:ToggleSwitch Grid.Row="0"
                                     Grid.RowSpan="2"
                                     Grid.Column="1"
                                     Margin="0,0,24,0"
                                     IsChecked="{Binding Config.RemoteTaskConfig.QqBotAllowGroup, Mode=TwoWay}" />
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="忽略证书校验" />
                    <ui:TextBlock Grid.Row="1"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="代理做了中间人解密时，网关证书必然校验失败。优先把 api.sgroup.qq.com 加进直连；实在不行再打开这里。开启后机器人流量对代理可见，改完需重启程序。"
                                  TextWrapping="Wrap" />
                    <ui:ToggleSwitch Grid.Row="0"
                                     Grid.RowSpan="2"
                                     Grid.Column="1"
                                     Margin="0,0,24,0"
                                     IsChecked="{Binding Config.RemoteTaskConfig.QqBotAllowInsecureTls, Mode=TwoWay}" />
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="AppID" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1" Grid.Column="0"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="留空则复用「通知设置」里的 QQ AppID"
                                  TextWrapping="Wrap" />
                    <ui:TextBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                MinWidth="180" MaxWidth="800" Margin="0,0,36,0"
                                Text="{Binding Config.RemoteTaskConfig.QqBotAppId, Mode=TwoWay}"
                                TextWrapping="NoWrap" />
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="AppSecret" TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1" Grid.Column="0"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="留空则复用「通知设置」里的 QQ AppSecret"
                                  TextWrapping="Wrap" />
                    <ui:TextBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                MinWidth="180" MaxWidth="800" Margin="0,0,36,0"
                                Text="{Binding Config.RemoteTaskConfig.QqBotAppSecret, Mode=TwoWay}"
                                TextWrapping="NoWrap" />
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="没跑成时回传画面" />
                    <ui:TextBlock Grid.Row="1"
                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                  Text="失败或取消才截，成功时只发结果与告警（跑完站那的截图没信息量）"
                                  TextWrapping="Wrap" />
                    <ui:ToggleSwitch Grid.Row="0"
                                     Grid.RowSpan="2"
                                     Grid.Column="1"
                                     Margin="0,0,24,0"
                                     IsChecked="{Binding Config.RemoteTaskConfig.ScreenshotOnFinish, Mode=TwoWay}" />
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock FontTypography="Body" Text="截图最长边 / 质量" />
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="最长边 0 表示不缩放；质量越低上传越快"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:TextBox Grid.Column="1"
                                Width="90"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center"
                                Text="{Binding Config.RemoteTaskConfig.ScreenshotMaxWidth, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}" />
                    <ui:TextBox Grid.Column="2"
                                Width="90"
                                Margin="0,0,24,0"
                                VerticalAlignment="Center"
                                Text="{Binding Config.RemoteTaskConfig.ScreenshotQuality, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}" />
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock FontTypography="Body" Text="允许的 OpenID" />
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="逗号或换行分隔；留空时第一个发消息的人自动成为所有者"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:TextBox Grid.Column="1"
                                MinHeight="60"
                                MaxHeight="120"
                                Margin="0,0,36,0"
                                AcceptsReturn="True"
                                Text="{Binding Config.RemoteTaskConfig.QqBotAllowedOpenIds, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock FontTypography="Body" Text="对话人格" />
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="只影响措辞，不影响任务解析"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Margin="0,0,36,0"
                              SelectedValue="{Binding Config.RemoteTaskConfig.PersonaPreset, Mode=TwoWay}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="默认助手" Tag="default" />
                        <ComboBoxItem Content="哥伦比娅" Tag="columbina" />
                        <ComboBoxItem Content="别扭的同伴" Tag="tsundere" />
                    </ComboBox>
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock FontTypography="Body" Text="自由操作" />
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="没有对应任务时，由大模型看画面自己点；右侧是一次最多几步"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     Margin="0,0,16,0"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding Config.RemoteTaskConfig.SelfLearningEnabled, Mode=TwoWay}" />
                    <ui:TextBox Grid.Column="2"
                                Width="80"
                                Margin="0,0,24,0"
                                VerticalAlignment="Center"
                                Text="{Binding Config.RemoteTaskConfig.SelfLearningMaxSteps, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}" />
                </Grid>
                <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock FontTypography="Body" Text="米游社 Cookie / UID" />
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="扫一次码就能不开游戏查树脂；留空时改为截图识别"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,36,0">
                        <ui:TextBox MinHeight="56"
                                    MaxHeight="100"
                                    AcceptsReturn="True"
                                    PlaceholderText="ltuid_v2=...; ltoken_v2=..."
                                    Text="{Binding Config.RemoteTaskConfig.MysCookie, Mode=TwoWay}"
                                    TextWrapping="Wrap" />
                        <ui:TextBox Margin="0,8,0,0"
                                    PlaceholderText="原神 UID，例如 100000000"
                                    Text="{Binding Config.RemoteTaskConfig.MysUid, Mode=TwoWay}" />
                        <ui:Button Margin="0,10,0,0"
                                   HorizontalAlignment="Left"
                                   Click="OnMysLoginClick"
                                   Content="扫码绑定米游社" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ui:CardExpander>
    </StackPanel>
</UserControl>

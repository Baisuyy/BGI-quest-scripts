<Page x:Class="BetterGenshinImpact.View.Pages.SearchResultPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:BetterGenshinImpact.ViewModel.Pages"
      xmlns:search="clr-namespace:BetterGenshinImpact.Service.Search"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="SearchResultPage"
      d:DataContext="{d:DesignInstance Type=pages:SearchResultPageViewModel}"
      d:DesignHeight="600"
      d:DesignWidth="900"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Text="{Binding Query, StringFormat=搜索：{0}}" />
            <TextBlock Margin="0,4,0,16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Summary}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:SearchResultGroup}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Margin="2,0,0,6"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding Title}" />

                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type search:SearchHit}">
                                        <ui:Button Margin="0,0,0,4"
                                                   Padding="12,8"
                                                   HorizontalAlignment="Stretch"
                                                   HorizontalContentAlignment="Stretch"
                                                   Appearance="Transparent"
                                                   Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"
                                                   Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Margin="0,0,10,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="16"
                                                               Symbol="Search24" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontSize="14" Text="{Binding Title}" />
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="{Binding Subtitle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </ui:Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 无结果：给几个能直接用的例子，比一句「未找到」有用 -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:SymbolIcon Margin="0,0,0,12"
                           HorizontalAlignment="Center"
                           FontSize="32"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Symbol="Search24" />
            <TextBlock HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="试试：日志、圣遗物、录制、地图追踪、清体力"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>

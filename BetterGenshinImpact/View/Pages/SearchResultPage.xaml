<Page x:Class="BetterGenshinImpact.View.Pages.SearchResultPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:BetterGenshinImpact.ViewModel.Pages"
      xmlns:search="clr-namespace:BetterGenshinImpact.Service.Search"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="SearchResultPage"
      d:DataContext="{d:DesignInstance Type=pages:SearchResultPageViewModel}"
      d:DesignHeight="600"
      d:DesignWidth="900"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部：返回 + 就地重搜 + 结果数。搜索页不在左侧导航里，没返回按钮就只能乱点  -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Command="{Binding GoBackCommand}"
                       Icon="{ui:SymbolIcon ArrowLeft24}"
                       ToolTip="返回上一页" />

            <ui:TextBox Grid.Column="1"
                        Width="320"
                        Height="34"
                        VerticalAlignment="Center"
                        Icon="{ui:SymbolIcon Search24}"
                        PlaceholderText="搜索页面、任务、脚本  (Ctrl+K)"
                        Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>

            <ui:TextBlock Grid.Column="2"
                          Margin="14,0,0,0"
                          VerticalAlignment="Center"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="{Binding Summary, Mode=OneWay}"
                          TextTrimming="CharacterEllipsis" />
        </Grid>

        <!--  结果：一层分组一张卡，卡片内条目之间用细线分开  -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasResults, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding Groups, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:SearchResultGroup}">
                        <Border Margin="0,0,0,14"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <!--  组标题：数量跟在后面，省得再数一遍  -->
                                <Border Padding="14,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock FontTypography="Caption"
                                                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                      Text="{Binding Title, Mode=OneWay}" />
                                        <ui:TextBlock Margin="8,0,0,0"
                                                      FontTypography="Caption"
                                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                      Text="{Binding Items.Count, StringFormat={}{0} 条}" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Items, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type search:SearchHit}">
                                            <ui:Button Margin="6,2"
                                                       Padding="10,8"
                                                       HorizontalAlignment="Stretch"
                                                       HorizontalContentAlignment="Stretch"
                                                       Appearance="Transparent"
                                                       Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}"
                                                       Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Margin="0,0,10,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="15"
                                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                                   Symbol="Search24" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <ui:TextBlock FontTypography="Body" Text="{Binding Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                        <ui:TextBlock FontTypography="Caption"
                                                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                                      Text="{Binding Subtitle, Mode=OneWay}"
                                                                      TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <ui:SymbolIcon Grid.Column="2"
                                                                   Margin="10,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                                   Symbol="ChevronRight24" />
                                                </Grid>
                                            </ui:Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  无结果：给几个能直接用的例子，比一句「未找到」有用  -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:SymbolIcon Margin="0,0,0,12"
                           HorizontalAlignment="Center"
                           FontSize="32"
                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                           Symbol="Search24" />
            <ui:TextBlock HorizontalAlignment="Center"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="{Binding Summary, Mode=OneWay}"
                          TextAlignment="Center"
                          TextWrapping="Wrap" />
            <ui:TextBlock Margin="0,6,0,0"
                          HorizontalAlignment="Center"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="试试：日志、圣遗物、录制、地图追踪、清体力" />
        </StackPanel>
    </Grid>
</Page>

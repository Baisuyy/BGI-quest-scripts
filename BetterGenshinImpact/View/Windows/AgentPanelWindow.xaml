<Window x:Class="BetterGenshinImpact.View.Windows.AgentPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:microsoft="clr-namespace:BetterGenshinImpact.View.Windows"
        Title="BetterGI 助手"
        Width="460"
        Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Deactivated="OnDeactivated">

    <Window.Resources>
        <!-- 深色半透明：压在游戏画面上也不刺眼，且不挡住背后的战斗信息 -->
        <SolidColorBrush x:Key="PanelBackground" Color="#F21A1A1C" />
        <SolidColorBrush x:Key="PanelBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="MutedText" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- 主按钮：悬停变亮而不是变灰，避免强调色被 hover 的那层白盖住 -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#0B0B0C" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#7FD4FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#35A8E0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 快捷键胶囊：一眼能读到，但不像按钮那样抢注意力 -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>

        <!-- 一条消息的气泡：用户靠右、AI 靠左、工具步骤压成小字。
             以前整块是一个 TextBlock，模型说的话和 [3/16] 步骤混在同一行，分不清谁在说。 -->
        <DataTemplate x:Key="MessageTemplate">
            <Border x:Name="Bubble"
                    MaxWidth="386"
                    Margin="0,2"
                    Padding="9,6"
                    CornerRadius="9"
                    HorizontalAlignment="Left"
                    Background="#1FFFFFFF">
                <TextBlock x:Name="BubbleText"
                           Text="{Binding Text}"
                           TextWrapping="Wrap"
                           Foreground="#E9FFFFFF"
                           FontSize="12.5"
                           LineHeight="19" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static microsoft:PanelMessageKind.User}">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="Background" Value="#5A4CC2FF" />
                    <Setter TargetName="BubbleText" Property="Foreground" Value="#08121A" />
                    <Setter TargetName="BubbleText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static microsoft:PanelMessageKind.Ai}">
                    <Setter TargetName="Bubble" Property="Background" Value="#2BFFFFFF" />
                    <Setter TargetName="Bubble" Property="CornerRadius" Value="9,9,9,3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static microsoft:PanelMessageKind.Step}">
                    <Setter TargetName="Bubble" Property="Background" Value="Transparent" />
                    <Setter TargetName="Bubble" Property="Padding" Value="3,0" />
                    <Setter TargetName="Bubble" Property="MaxWidth" Value="396" />
                    <Setter TargetName="BubbleText" Property="Foreground" Value="#8CFFFFFF" />
                    <Setter TargetName="BubbleText" Property="FontSize" Value="11.5" />
                    <Setter TargetName="BubbleText" Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static microsoft:PanelMessageKind.Ok}">
                    <Setter TargetName="Bubble" Property="Background" Value="#266DDC8F" />
                    <Setter TargetName="BubbleText" Property="Foreground" Value="#C2F3D2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static microsoft:PanelMessageKind.Fail}">
                    <Setter TargetName="Bubble" Property="Background" Value="#26FF8A8A" />
                    <Setter TargetName="BubbleText" Property="Foreground" Value="#FFCCCC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static microsoft:PanelMessageKind.Hint}">
                    <Setter TargetName="Bubble" Property="Background" Value="Transparent" />
                    <Setter TargetName="Bubble" Property="Padding" Value="3,0" />
                    <Setter TargetName="BubbleText" Property="Foreground" Value="#85FFFFFF" />
                    <Setter TargetName="BubbleText" Property="FontSize" Value="11.5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="12"
            MouseLeftButtonDown="OnDragArea">
        <Grid Margin="12,10,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部：状态灯 + 标题 + 快捷键 + 关窗 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FFB020"
                             VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="BGI 助手" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" />
                    <Border Style="{StaticResource KeyCap}">
                        <TextBlock x:Name="HintText" Text="Ctrl+Alt+A" Foreground="{StaticResource MutedText}"
                                   FontSize="10.5" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SettingsButton" Content="⚙" Style="{StaticResource IconButton}"
                            ToolTip="打开 AI 助手设置" Click="OnOpenSettings" />
                    <Button x:Name="CloseButton" Content="✕" Style="{StaticResource IconButton}"
                            ToolTip="隐藏（快捷键可再次唤起）" Click="OnHide" />
                </StackPanel>
            </Grid>

            <!-- 中部：对话流（用户 / AI / 工具步骤分色）。没有任何消息时给一句能直接照抄的例子 -->
            <Border Grid.Row="1" Background="#14FFFFFF" CornerRadius="8" Padding="8,6">
                <Grid>
                    <ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="OutputList" ItemTemplate="{StaticResource MessageTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=OutputList}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="#6FFFFFFF"
                                   FontSize="12"
                                   Text="说一句话就开始" />
                        <TextBlock Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#4DFFFFFF"
                                   FontSize="11"
                                   Text="试试「清一下体力」「打开地图追踪」" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 底部：输入 + 发送/停止 -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1FFFFFFF" CornerRadius="8" Padding="8,4">
                    <Grid>
                        <TextBox x:Name="InputBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 CaretBrush="White"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="False"
                                 MaxHeight="56"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Center"
                                 KeyDown="OnInputKeyDown" />
                        <!-- 水印：只在输入框为空时出现，不拦截点击 -->
                        <TextBlock Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#59FFFFFF"
                                   FontSize="12.5"
                                   IsHitTestVisible="False"
                                   Text="输入任务或问题，回车发送">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <Button x:Name="SendButton" Grid.Column="1" Content="发送"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        MinWidth="64"
                        Click="OnSend" />
            </Grid>
        </Grid>
    </Border>
</Window>

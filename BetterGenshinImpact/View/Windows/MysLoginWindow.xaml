<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.MysLoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="620"
                 Height="430"
                 MinWidth="520"
                 MinHeight="380"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="{DynamicResource TextThemeFontFamily}"
                 ResizeMode="CanResize"
                 WindowBackdropType="Auto"
                 WindowStartupLocation="CenterOwner"
                 WindowStyle="SingleBorderWindow"
                 mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="米游社扫码绑定">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/Images/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="20,8,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="264"
                    Height="264"
                    Background="White"
                    BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Image x:Name="QrImage"
                       Margin="6"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <ui:TextBlock x:Name="StatusText"
                              FontTypography="Body"
                              Text="正在生成二维码…"
                              TextWrapping="Wrap" />

                <ComboBox x:Name="RolePicker"
                          Margin="0,16,0,0"
                          DisplayMemberPath="Display"
                          Visibility="Collapsed" />
                <ui:Button x:Name="ConfirmRoleButton"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Left"
                           Click="OnConfirmRoleClick"
                           Content="绑定这个角色"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="20,12,20,20"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0" Click="OnRefreshClick" Content="换一张二维码" />
            <ui:Button Click="OnCloseClick" Content="关闭" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
